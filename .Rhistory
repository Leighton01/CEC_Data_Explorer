install.packages
(c("shiny", "bslib", "DT", "duckdb", "readxl", "dplyr"))
install.packages(c("shiny", "bslib", "DT", "duckdb", "readxl", "dplyr"))
shiny::runApp()
shiny::runApp()
shiny::runApp()
# CEC Database Explorer - Enhanced Prototype
library(shiny)
library(bslib)
library(DT)
library(duckdb)
library(readxl)
library(dplyr)
# Global database connection
db_con <- NULL
# Data loading function
load_data <- function() {
base_path <- "C:/Users/Leigh/Documents/GitHub_Projects/CECdata"
# Connect to DuckDB (in-memory)
con <- dbConnect(duckdb::duckdb(), ":memory:")
# Load Excel files
chemicals_raw <- read_excel(file.path(base_path, "CEC_Table_Chemicals_0811.xlsx"))
info <- read_excel(file.path(base_path, "CEC_Table_Information_20260917.xlsx"))
measurements <- read_excel(file.path(base_path, "CEC_Table_Measurements_20260902.xlsx"))
properties <- read_excel(file.path(base_path, "CEC_Table_Properties_0713.xlsx"))
# Register tables
duckdb_register(con, "chemicals", chemicals)
duckdb_register(con, "info", info)
duckdb_register(con, "measurements", measurements)
duckdb_register(con, "properties", properties)
return(con)
}
# UI
ui <- page_navbar(
title = "CEC Database Explorer",
theme = bs_theme(preset = "bootstrap"),
nav_panel(
"Chemical Explorer",
card(
card_header("Search Chemicals"),
textInput("search", "Search", placeholder = "Name, InChIKey, or CAS..."),
DTOutput("chemicals_table")
)
),
nav_panel(
"Chemical Profile",
uiOutput("profile_content")
)
)
# Server
server <- function(input, output, session) {
# Initialize database on startup
isolate({
db_con <<- load_data()
})
selected_chemical <- reactiveVal(NULL)
# Chemicals table with search
output$chemicals_table <- renderDT({
req(db_con)
# Base query
query <- "SELECT name, InChIKey as inchikey, cas FROM chemicals"
# Add search filter if provided
if (!is.null(input$search) && nchar(input$search) > 0) {
search_term <- tolower(input$search)
query <- sprintf(
"SELECT name, InChIKey as inchikey, cas FROM chemicals
WHERE LOWER(name) LIKE '%%%s%%'
OR LOWER(InChIKey) LIKE '%%%s%%'
OR LOWER(cas) LIKE '%%%s%%'
OR LOWER(IUPACName) LIKE '%%%s%%'",
search_term, search_term, search_term, search_term
)
}
data <- dbGetQuery(db_con, query)
datatable(
data,
selection = 'single',
options = list(
pageLength = 25,
scrollX = TRUE
),
rownames = FALSE
)
})
# Handle row selection
observeEvent(input$chemicals_table_rows_selected, {
req(input$chemicals_table_rows_selected)
# Get current filtered data
query <- "SELECT name, InChIKey as inchikey, cas FROM chemicals"
if (!is.null(input$search) && nchar(input$search) > 0) {
search_term <- tolower(input$search)
query <- sprintf(
"SELECT name, InChIKey as inchikey, cas FROM chemicals
WHERE LOWER(name) LIKE '%%%s%%'
OR LOWER(InChIKey) LIKE '%%%s%%'
OR LOWER(cas) LIKE '%%%s%%'
OR LOWER(IUPACName) LIKE '%%%s%%'",
search_term, search_term, search_term, search_term
)
}
data <- dbGetQuery(db_con, query)
selected_chemical(data$inchikey[input$chemicals_table_rows_selected])
updateNavbarPage(session, inputId = NULL, selected = "Chemical Profile")
})
# Profile content - comprehensive view
output$profile_content <- renderUI({
if (is.null(selected_chemical())) {
return(card(
card_header("No Chemical Selected"),
p("Please select a chemical from the Explorer tab")
))
}
# Get chemical details
chem_query <- sprintf("SELECT * FROM chemicals WHERE InChIKey = '%s'", selected_chemical())
chem_data <- dbGetQuery(db_con, chem_query)
if (nrow(chem_data) == 0) {
return(card(
card_header("Error"),
p("Chemical not found in database")
))
}
# Get additional info
info_query <- sprintf("SELECT info_type, content FROM info WHERE inchikey = '%s'", selected_chemical())
info_data <- dbGetQuery(db_con, info_query)
# Get measurements
meas_query <- sprintf("SELECT * FROM measurements WHERE inchikey = '%s'", selected_chemical())
meas_data <- dbGetQuery(db_con, meas_query)
# Get properties
prop_query <- sprintf("SELECT * FROM properties WHERE inchikey = '%s'", selected_chemical())
prop_data <- dbGetQuery(db_con, prop_query)
# Build UI
tagList(
# Chemical Details Card
card(
card_header(paste("Chemical Details:", chem_data$name)),
layout_columns(
col_widths = c(6, 6),
div(
h4("Identifiers"),
p(strong("Name: "), chem_data$name),
p(strong("InChIKey: "), chem_data$InChIKey),
p(strong("CAS Number: "), chem_data$cas),
p(strong("PubChem CID: "), chem_data$cid),
p(strong("DTXSID: "), chem_data$dtxsid),
p(strong("DTXCID: "), chem_data$dtxcid)
),
div(
h4("Structure"),
p(strong("Molecular Formula: "), chem_data$MolecularFormula),
p(strong("SMILES: "), code(chem_data$SMILES)),
p(strong("InChI: "), code(chem_data$InChI)),
if (!is.na(chem_data$IUPACName)) p(strong("IUPAC Name: "), chem_data$IUPACName)
)
),
if (!is.na(chem_data$label)) p(strong("Category: "), span(chem_data$label, class = "badge bg-primary")),
if (!is.na(chem_data$desc)) {
div(
hr(),
h4("Description"),
p(chem_data$desc)
)
}
),
# Additional Information Card
if (nrow(info_data) > 0) {
card(
card_header(paste("Additional Information (", nrow(info_data), " records)")),
DTOutput("info_table")
)
},
# Measurements Card
card(
card_header(paste("Environmental Measurements (", nrow(meas_data), " records)")),
if (nrow(meas_data) > 0) {
DTOutput("measurements_table")
} else {
p("No measurement data available for this chemical")
}
),
# Properties Card
card(
card_header(paste("Chemical Properties (", nrow(prop_data), " records)")),
if (nrow(prop_data) > 0) {
DTOutput("properties_table")
} else {
p("No property data available for this chemical")
}
)
)
})
# Info table
output$info_table <- renderDT({
req(selected_chemical())
info_query <- sprintf("SELECT info_type, content FROM info WHERE inchikey = '%s'", selected_chemical())
info_data <- dbGetQuery(db_con, info_query)
datatable(
info_data,
colnames = c("Property Type", "Value"),
options = list(
pageLength = 10,
scrollX = TRUE,
dom = 'tip'
),
rownames = FALSE
)
})
# Measurements table
output$measurements_table <- renderDT({
req(selected_chemical())
meas_query <- sprintf("SELECT * FROM measurements WHERE inchikey = '%s'", selected_chemical())
meas_data <- dbGetQuery(db_con, meas_query)
datatable(
meas_data,
options = list(
pageLength = 10,
scrollX = TRUE,
scrollY = "400px"
),
rownames = FALSE,
filter = 'top'
)
})
# Properties table
output$properties_table <- renderDT({
req(selected_chemical())
prop_query <- sprintf("SELECT prop_name, value, unit, type, conditions FROM properties WHERE inchikey = '%s'", selected_chemical())
prop_data <- dbGetQuery(db_con, prop_query)
datatable(
prop_data,
colnames = c("Property", "Value", "Unit", "Type", "Conditions"),
options = list(
pageLength = 15,
scrollX = TRUE
),
rownames = FALSE,
filter = 'top'
) %>%
formatStyle(
'type',
target = 'row',
backgroundColor = styleEqual(
c('experimental', 'predicted'),
c('#e8f5e9', '#fff9c4')
)
)
})
# Cleanup
onStop(function() {
if (!is.null(db_con)) dbDisconnect(db_con)
})
}
shinyApp(ui, server)
shiny::runApp()
runApp('app2.R')
runApp('app2.R')
runApp('app2.R')
runApp('app2.R')
runApp()
runApp()
